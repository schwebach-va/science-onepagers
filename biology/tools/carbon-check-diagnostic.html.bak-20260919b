<script>
const BANDS=[
 {id:"skeletons",sym:"C=C",name:"Carbon skeletons and isomers",color:"#4C5A56",
  task:"Draw the same six carbons four ways: a straight chain, a branched chain, a ring, and a chain with one double bond in the middle. Same formula every time, four different molecules. On the double-bonded one, circle the six atoms that are locked flat, and on the branched one mark the carbon that carries four different groups. That carbon is the one that can be built as two mirror images."},
 {id:"groups",sym:"—OH",name:"Functional groups",color:"#3F7A55",
  task:"Make seven cards, one for each group: hydroxyl, carbonyl, carboxyl, amino, sulfhydryl, phosphate, methyl. Draw the group on the front. On the back write one thing it does and one molecule that carries it. Then deal yourself the drawing side only and name them. Naming a group off a picture is the version the Checkpoint asks for."},
 {id:"polymers",sym:"−H₂O",name:"Building and breaking polymers",color:"#8C5222",
  task:"Draw three hexagons in a row for three sugars, and write in the water molecule that had to leave at each join. Then draw the arrow the other way and write the water that has to be added to take it apart. Do the same row again with three circles for amino acids, and once more with three nucleotides. Same bookkeeping, three different polymers — that is the point of doing it three times."},
 {id:"carbs",sym:"C₆",name:"Carbohydrates",color:"#C98A2E",
  task:"Handle the two printed models side by side and sight along a ring until you find where the linkage bond leaves it — straight out the side in cellulose, up out of the ring plane in starch. Then draw both linkages from memory and write beside each one what your own gut enzymes can do with it. One bond angle, two completely different foods."},
 {id:"lipids",sym:"C–H",name:"Lipids",color:"#B85042",
  task:"Draw a glycerol with three capsule tails. Leave two tails straight and put a kink in the third where a cis double bond sits. Say out loud which version packs tightly enough to be solid in the fridge, and why the kink is the whole reason. Then add a four-ring steroid beside it and write what those two have in common, since it is not a shared building block."},
 {id:"proteins",sym:"R",name:"Proteins",color:"#1F7A8C",
  task:"Draw a chain of eight circles for eight amino acids and trace the backbone through them in one colour. Put the hydrogen bonds that coil it into a helix between backbone atoms only. Then draw a separate loop where two R groups reach across and touch. Label your own drawing primary, secondary and tertiary in the right three places."},
 {id:"nucleic",sym:"PO₄",name:"Nucleic acids",color:"#6B4E8C",
  task:"Draw one nucleotide in three shapes: a pentagon for the five-carbon sugar, a rounded rectangle for the base, a circle for the phosphate. Chain three of them together and mark which end is 5' and which is 3'. Write the complementary strand underneath, then count the guanines and the cytosines and see what the two counts do."}
];

const ITEMS=[
 {b:0,q:"Two carbon atoms are joined by a double bond. The two carbons and the four atoms attached to them sit:",
  o:["At the corners of a tetrahedron",
     "All in one flat plane",
     "In a straight line",
     "In whatever arrangement they rotate into"],a:1,
  w:"A single bond lets the two ends spin freely. A double bond locks them, and all six atoms lie flat. That rigidity is why a fatty acid with a cis double bond is a different molecule from the trans version, and why the two behave so differently in a body."},
 {b:0,q:"A carbon in the middle of a saturated chain is bonded to four other atoms by single bonds. Those four neighbours are arranged:",
  o:["Flat, at the corners of a square",
     "In two pairs pointing opposite ways",
     "At the corners of a tetrahedron, pointing into three dimensions",
     "Along a single straight axis"],a:2,
  w:"Four bonding pairs push as far from each other as they can, and the furthest apart they can get is the tetrahedron. This is why a long chain zigzags in three dimensions instead of lying flat, and why proteins can fold into shapes at all."},
 {b:0,q:"Ibuprofen is sold as a mixture of two forms that are mirror images of each other and cannot be laid on top of one another. Only one form relieves pain. Those two forms are:",
  o:["Isotopes","Enantiomers","Polymers","Ions"],a:1,
  w:"A carbon carrying four different groups can be assembled two ways, and the two results are mirror images. A receptor is built to fit one of them, so one form works and the other is along for the ride. Same formula, same bonds, different handedness."},

 {b:1,q:"Which functional group makes the part of a molecule that carries it acidic?",
  o:["Hydroxyl, —OH","Amino, —NH₂","Carboxyl, —COOH","Methyl, —CH₃"],a:2,
  w:"A carboxyl gives up its hydrogen as H⁺ and is left negative. An amino group does the opposite, taking a hydrogen on and going positive. Every amino acid carries one of each, which is why a protein's behaviour shifts when the pH around it shifts."},
 {b:1,q:"Cells move energy from one organic molecule to another by transferring which group?",
  o:["Phosphate","Hydroxyl","Carbonyl","Sulfhydryl"],a:0,
  w:"Phosphates carry negative charge and crowd each other, so a bond between two of them gives up energy readily when it breaks. ATP is three of them in a row. Every time you meet the word phosphorylated later in the course, this is what happened."},
 {b:1,q:"Testosterone and estradiol are both built on the same four-ring steroid skeleton, yet they do very different things. The difference is:",
  o:["The number of carbon rings in the skeleton",
     "One is a lipid and the other is not",
     "The functional groups attached at particular positions on the rings",
     "The isotopes of carbon each one contains"],a:2,
  w:"The skeleton is nearly identical; a hydroxyl in one place instead of a carbonyl is most of what separates them. Small chemical differences at the right position produce very different signals, which is the argument for learning the groups rather than memorising whole molecules."},

 {b:2,q:"Two monomers are joined into a growing polymer. What else appears?",
  o:["A molecule of water","A phosphate ion","A molecule of carbon dioxide","Nothing else is produced"],a:0,
  w:"One monomer gives up a hydroxyl, the other gives up a hydrogen, and those pieces leave together as water. That is what dehydration means here — water removed so a bond can form."},
 {b:2,q:"How does hydrolysis relate to a dehydration reaction?",
  o:["Hydrolysis adds a water molecule to break the bond that dehydration formed by removing one",
     "Both reactions release water",
     "Hydrolysis joins monomers and dehydration separates them",
     "They act on different classes of macromolecule"],a:0,
  w:"Water leaving makes the bond; water going back in breaks it. Digestion is hydrolysis on a large scale, which is why enzymes that break food down cannot work in a dry mouth."},
 {b:2,q:"A cell is actively synthesising macromolecules. What should be accumulating in the fluid around it?",
  o:["Amino acids","Water","Alcohol","Phosphate ions"],a:1,
  w:"Every bond formed sends one water molecule out. Monomers are being consumed, not produced, so they are going down while water goes up. Reading a reaction by what accumulates is a habit worth building now."},

 {b:3,q:"You are handed a polysaccharide and told that glucose is its only subunit. Which polysaccharide is it?",
  o:["Starch","Cellulose","Glycogen","That is not enough information to say"],a:3,
  w:"Starch, cellulose and glycogen are all built from glucose alone. What separates them is how the glucose units are linked and how much the chain branches. Composition does not identify a macromolecule; arrangement does."},
 {b:3,q:"Humans can digest starch but not cellulose because:",
  o:["Cellulose molecules are too large to enter a cell",
     "Our enzymes hydrolyse the α linkages of starch and cannot act on the β linkages of cellulose",
     "Cellulose contains nitrogen and starch does not",
     "Starch is a monomer and cellulose is a polymer"],a:1,
  w:"The glucose is identical in both. The bond at carbon one leaves the ring in a different direction, and an enzyme that fits one orientation will not fit the other. An entire category of food — fibre — exists because of that single angle."},
 {b:3,q:"Which of these polymers contains no nitrogen at all?",
  o:["A protein","DNA","Cellulose","Chitin"],a:2,
  w:"Proteins carry nitrogen in every amino group, DNA carries it in every base, and chitin is a carbohydrate that has had an amino group added. Cellulose is carbon, hydrogen and oxygen only. Knowing which elements a class must contain lets you rule molecules out fast."},

 {b:4,q:"Lipids are grouped together as one class because:",
  o:["They are all built from a repeating monomer",
     "They are largely nonpolar, so they mix poorly with water",
     "They all contain nitrogen and phosphorus",
     "They all store the same amount of energy"],a:1,
  w:"Lipids are the one class defined by behaviour rather than by a shared building block. Fats, steroids and phospholipids look nothing alike; they are grouped because long runs of C–H bonds give water no reason to hold on to them."},
 {b:4,q:"A fat whose tails carry cis double bonds is liquid at room temperature, while one with saturated tails is solid. The reason is:",
  o:["Unsaturated fats contain less carbon",
     "Each cis double bond puts a kink in the tail, so the tails cannot pack tightly against each other",
     "Unsaturated fats are polar and dissolve in water",
     "Saturated fats are held together by hydrogen bonds"],a:1,
  w:"Straight tails stack neatly and hold each other in place, which makes a solid. A kink keeps them apart, and loosely packed tails slide — an oil. The same packing logic decides how fluid a cell membrane is."},
 {b:4,q:"Gram for gram, which class stores the most energy?",
  o:["Carbohydrates","Proteins","Lipids","Nucleic acids"],a:2,
  w:"Energy is stored in C–H bonds, and a fatty acid tail is almost nothing but C–H bonds. A carbohydrate carries an oxygen on nearly every carbon, so it is already part way oxidised and has less left to give. That difference is why fat is what a body stores for the long term."},

 {b:5,q:"Which two functional groups are found on every amino acid?",
  o:["Hydroxyl and phosphate","Amino and carboxyl","Carbonyl and methyl","Sulfhydryl and amino"],a:1,
  w:"An amino group at one end, a carboxyl at the other, a hydrogen and an R group on the central carbon. Twenty amino acids differ only in that R group. The amino and carboxyl ends are what let them link head to tail into a chain."},
 {b:5,q:"What holds a protein's secondary structure — its helices and pleated sheets — in place?",
  o:["Hydrogen bonds between atoms of the polypeptide backbone",
     "Covalent bonds between R groups",
     "Ionic bonds between the two ends of the chain",
     "The peptide bonds themselves"],a:0,
  w:"Secondary structure ignores the R groups entirely and comes from regular hydrogen bonding along the backbone. R groups come into it at the next level up, tertiary, where they reach across the folded chain and hold it there."},
 {b:5,q:"An enzyme works best at pH 6. Moved to pH 5, its activity drops sharply. The most likely reason is:",
  o:["The peptide bonds were hydrolysed",
     "The change in charge disrupted the bonds between R groups that hold its folded shape",
     "The primary sequence changed",
     "The enzyme was diluted"],a:1,
  w:"Extra hydrogen ions change which R groups are charged, and the attractions holding the fold together give way. The chain is intact — the sequence has not changed — but the shape is gone, and shape is the whole of what an enzyme does."},

 {b:6,q:"A single nucleotide is made of:",
  o:["Two sugars and a base",
     "An amino group, a carboxyl group and an R group",
     "A five-carbon sugar, a nitrogenous base and a phosphate group",
     "A glycerol and three fatty acids"],a:2,
  w:"Three parts, and the sugar is the hub that the other two attach to. The phosphate of one nucleotide bonds to the sugar of the next, which builds the backbone and leaves the bases pointing inward."},
 {b:6,q:"A sample of double-stranded DNA is 20% guanine. What percentage is cytosine?",
  o:["20%","30%","40%","It cannot be determined"],a:0,
  w:"Guanine pairs only with cytosine, so the two counts match. That leaves 60% for adenine and thymine, split evenly at 30% each. This pattern held across every organism anyone tested, and it was one of the clues that gave away the double helix."},
 {b:6,q:"A supplement is analysed and found to contain only carbon, hydrogen, oxygen and sulfur. What can you safely conclude?",
  o:["It contains no protein","It contains no nucleic acid","It contains no lipid","It contains only carbohydrate"],a:1,
  w:"Every nucleotide carries a phosphate, so no phosphorus means no nucleic acid. Protein is still possible — sulfur points toward it, since two amino acids carry sulfur. Each class has an element signature, and the missing element is often the fastest way to answer."}
];

const $=id=>document.getElementById(id);
let i=0,answers=new Array(ITEMS.length).fill(null);

function tile(b,idx,score){
  const d=document.createElement("div");
  d.className="tile";
  d.style.setProperty("--accent",b.color);
  if(score!==undefined){
    if(score===3)d.classList.add("solid");
    else if(score===2)d.classList.add("mid");
    else d.classList.add("flag");
  }
  d.innerHTML='<span class="idx">'+(idx+1)+'</span>'+
    (score!==undefined?'<span class="score">'+score+'/3</span>':'')+
    '<span class="sym">'+b.sym+'</span><span class="nm">'+b.name+'</span>';
  return d;
}
BANDS.forEach((b,n)=>$("introGrid").appendChild(tile(b,n)));

function render(){
  const it=ITEMS[i];
  $("bandName").textContent=BANDS[it.b].name;
  $("counter").textContent=(i+1)+" of "+ITEMS.length;
  $("fill").style.width=(i/ITEMS.length*100)+"%";
  $("stem").textContent=it.q;
  $("why").classList.add("hidden");
  $("next").classList.add("hidden");
  const box=$("opts");box.innerHTML="";
  it.o.forEach((text,n)=>{
    const btn=document.createElement("button");
    btn.className="opt";btn.type="button";btn.textContent=text;
    btn.addEventListener("click",()=>choose(n));
    box.appendChild(btn);
  });
  window.scrollTo(0,0);
}

function choose(n){
  const it=ITEMS[i];
  answers[i]=(n===it.a);
  [...$("opts").children].forEach((b,k)=>{
    b.disabled=true;
    if(k===it.a)b.classList.add("right");
    else if(k===n)b.classList.add("wrong");
  });
  $("whyTag").textContent=(n===it.a)?"Right — and here is why":"The reasoning";
  $("whyText").textContent=it.w;
  $("why").classList.remove("hidden");
  $("next").textContent=(i===ITEMS.length-1)?"See what it found":"Next";
  $("next").classList.remove("hidden");
  save();
}

$("next").addEventListener("click",()=>{
  if(i===ITEMS.length-1){finish();}
  else{i++;render();save();}
});

$("start").addEventListener("click",()=>{
  $("intro").classList.add("hidden");
  $("quiz").classList.remove("hidden");
  render();
});

function finish(){
  $("quiz").classList.add("hidden");
  $("results").classList.remove("hidden");
  const scores=BANDS.map((b,n)=>
    ITEMS.reduce((s,it,k)=>s+((it.b===n&&answers[k])?1:0),0));
  const total=scores.reduce((a,c)=>a+c,0);
  const weak=scores.filter(s=>s<=1).length;
  $("summary").textContent=
    total+" of 21 correct. "+
    (weak===0?"Nothing here is broken. Take the two lowest tiles, work their tasks once, and put your time into the Checkpoint instead."
     :weak===1?"One idea is carrying all the damage. Everything else is in reach once that one is fixed."
     :weak+" ideas need real work. Take them one at a time, in the order they appear below, and re-run this when you have done two of them.");
  const g=$("resultGrid");g.innerHTML="";
  BANDS.forEach((b,n)=>g.appendChild(tile(b,n,scores[n])));
  const holder=$("bands");holder.innerHTML="";
  BANDS.map((b,n)=>({b,n,s:scores[n]})).sort((x,y)=>x.s-y.s).forEach(({b,n,s})=>{
    const sec=document.createElement("section");
    sec.className="band"+(s<=1?" flag":"");
    sec.innerHTML='<h3>'+b.name+'</h3><p class="verdict">'+s+' of 3 — '+
      (s===3?"holds up":s===2?"one gap left":"start here")+'</p>'+
      (s<3?'<div class="do"><h4>Work it with your hands</h4><p>'+b.task+'</p></div>':'');
    holder.appendChild(sec);
  });
  window.scrollTo(0,0);
  save();
}

$("again").addEventListener("click",()=>{
  i=0;answers.fill(null);
  $("results").classList.add("hidden");
  $("quiz").classList.remove("hidden");
  render();save();
});

function save(){
  try{localStorage.setItem("carboncheck",JSON.stringify({i,answers}));}catch(e){}
}
try{
  const raw=localStorage.getItem("carboncheck");
  if(raw){
    const st=JSON.parse(raw);
    if(st&&Array.isArray(st.answers)&&st.answers.length===ITEMS.length&&st.answers.some(a=>a!==null)){
      answers=st.answers;i=Math.min(st.i||0,ITEMS.length-1);
      $("start").textContent="Pick up where you left off";
    }
  }
}catch(e){}
</script>
</body>
</html>
